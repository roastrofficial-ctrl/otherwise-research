FROM node:22-bookworm-slim AS verifier
FROM python:3.12-slim
COPY --from=verifier /usr/local/bin/node /usr/local/bin/node
WORKDIR /otherwise
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY Engine Engine
COPY Bounded Bounded
COPY Available Available
COPY Untrusted Untrusted
COPY Honest Honest
COPY Verifier Verifier
COPY tests06 tests06
COPY Missing Missing
COPY tests07 tests07
COPY LastWord LastWord
COPY tests08 tests08
COPY scripts/conformance08.py scripts/conformance08.py
COPY Protocol/vectors/generation08.json Protocol/vectors/generation08.json
COPY scripts/conformance07.py scripts/conformance07.py
COPY Protocol/vectors/generation07.json Protocol/vectors/generation07.json
COPY scripts/conformance04.py scripts/conformance04.py
COPY Protocol/vectors/generation04.json Protocol/vectors/generation04.json
ENV PYTHONPATH=/otherwise PYTHONDONTWRITEBYTECODE=1
CMD ["python","-m","unittest","discover","-s","tests08","-v"]
